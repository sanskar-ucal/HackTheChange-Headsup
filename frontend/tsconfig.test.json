{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": []
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules", "out", ".next", ".test-dist"]
}
